# Порт HTTP-сервера
PORT=3000

# Строка подключения к MongoDB.
# Важно: 127.0.0.1, а не localhost — на Windows localhost резолвится в IPv6 ::1,
# где MongoDB по умолчанию не слушает.
MONGODB_URI=mongodb://127.0.0.1:27017/web-app-dev

# Секрет для подписи JWT. Обязательно замените на свой в любом реальном запуске.
JWT_SECRET=change-me-to-a-long-random-string
